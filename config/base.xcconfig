// committed defaults shared by debug and release.
// private values live in local.xcconfig (gitignored), included at the bottom.

wolfified_bundle_id = wolf.knots.player
wolfified_private_flag =
// iOS 26 animated artwork (Sources/furmusecore/animatedartwork.swift). clear this if Xcode 26 rejects that file.
wolfified_animated_flag = WOLF_ANIMATED_ARTWORK
wolfified_spotify_client_id =
wolfified_lastfm_api_key =
wolfified_lastfm_shared_secret =

PRODUCT_NAME = furmuse
PRODUCT_BUNDLE_IDENTIFIER = $(wolfified_bundle_id)
MARKETING_VERSION = 1.1
CURRENT_PROJECT_VERSION = 4

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 5.0
CLANG_ENABLE_MODULES = YES
SWIFT_EMIT_LOC_STRINGS = YES
// the rust build phase runs cargo and writes to rust/out, which the user script sandbox forbids
ENABLE_USER_SCRIPT_SANDBOXING = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Support/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES = LegacyIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

#include? "local.xcconfig"
// written by rust/build.sh; links the librespot bridge when it has been built
#include? "rust.xcconfig"
